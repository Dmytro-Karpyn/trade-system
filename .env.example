# Local development only. Use a unique secret for deployment.
POSTGRES_DB=trade
POSTGRES_USER=trade
POSTGRES_PASSWORD=trade_local_password
POSTGRES_PORT=5432
# Set a public domain (e.g. trade.example.com) to enable automatic HTTPS.
CADDY_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Public browser API prefix used when building the Caddy/frontend image.
VITE_API_BASE_URL=/api
# Override if your Docker bridge network is outside this CIDR.
REVERSE_PROXY_KNOWN_NETWORK=172.16.0.0/12
