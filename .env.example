# Copy to a private .env file. Set your own passwords; examples are never credentials.
# For local PostgreSQL (compose.yaml), also set the matching backend connection string
# in PowerShell/bash or dotnet user-secrets. .NET does not read .env automatically.
POSTGRES_DB=trade
POSTGRES_USER=trade
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Production: use compose.production.yaml and a separate private --env-file.
# The PostgreSQL owner/migrator and API runtime role should be DIFFERENT users.
# Example shapes only (replace every placeholder before use):
# ConnectionStrings__TradeDatabase=Host=postgres;Database=trade;Username=trade_app;Password=YOUR_RUNTIME_SECRET;Timeout=5;Command Timeout=30
# MIGRATION_CONNECTION_STRING=Host=postgres;Database=trade;Username=trade_owner;Password=YOUR_OWNER_SECRET;Timeout=5;Command Timeout=30
ConnectionStrings__TradeDatabase=
MIGRATION_CONNECTION_STRING=

# localhost uses Caddy's local CA. Set your real DNS hostname for staging/production.
# ALLOWED_HOSTS is a hostname only, without scheme or port; semicolon separates hosts.
CADDY_SITE_ADDRESS=localhost
ALLOWED_HOSTS=localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TRADE_PROXY_SUBNET=172.30.250.0/24

# Public browser setting only. Production Compose fixes this to same-origin /api.
VITE_API_BASE_URL=/api
# Legacy local app profile only; production uses its dedicated /24 proxy network.
REVERSE_PROXY_KNOWN_NETWORK=172.16.0.0/12

# One-shot --bootstrap-admin ONLY: not an automatic seed and not passed to the API.
# Supply password through the operator environment for the maintenance command.
BootstrapAdmin__Username=
BootstrapAdmin__OrganizationId=
BootstrapAdmin__Password=
BootstrapAdmin__FullName=Administrator
# DevelopmentSeed__AdminPassword is deliberately absent from production Compose.
