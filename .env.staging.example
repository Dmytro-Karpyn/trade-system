# Public template only. Generate a private .env.staging on the staging VPS.
# python3 scripts/create-staging-env.py --domain YOUR_STAGING_DOMAIN --release-id YOUR_RELEASE_ID
# Never reuse production credentials or overwrite an existing environment file.
POSTGRES_DB=trade_staging
POSTGRES_USER=trade_staging_owner
POSTGRES_PASSWORD=
# Separate runtime credentials; this role must be provisioned after migrations.
POSTGRES_RUNTIME_USER=trade_staging_app
POSTGRES_RUNTIME_PASSWORD=
ConnectionStrings__TradeDatabase=
MIGRATION_CONNECTION_STRING=

# Production cookie/security behavior is intentional on staging.
ASPNETCORE_ENVIRONMENT=Production
CADDY_SITE_ADDRESS=
ALLOWED_HOSTS=
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TRADE_PROXY_SUBNET=172.30.251.0/24
TRADE_API_IMAGE=trade-system-api:staging-RELEASE_ID
TRADE_WEB_IMAGE=trade-system-web:staging-RELEASE_ID
VITE_API_BASE_URL=/api

# Password is supplied only to the explicit maintenance command via process env.
BootstrapAdmin__Username=staging-admin
BootstrapAdmin__OrganizationId=
BootstrapAdmin__Password=
BootstrapAdmin__FullName=Staging Administrator
# No DevelopmentSeed settings. DataProtection__KeysPath is fixed in Compose
# to its private persistent data_protection volume, not this env file.
